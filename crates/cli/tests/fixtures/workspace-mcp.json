[
  {
    "name": "stdio servers with every optional field, legacy names and odd env keys",
    "git": "repo",
    "workspace": "repo",
    "files": {
      "repo/.zcode/config.json": {
        "mcp": {
          "servers": {
            "full": {
              "type": "stdio",
              "command": "node",
              "args": ["server.js", "--port", "3000"],
              "env": {
                "TOKEN": "secret",
                "b": "y",
                "Ä": "x",
                "10": "ten",
                "2": "two",
                "Ａ": "wide",
                "😀": "smile"
              },
              "cwd": "tools",
              "isolation": "workspace",
              "timeoutMs": 1500.5,
              "alwaysLoad": true,
              "protocolVersion": "legacy"
            },
            "bare": {
              "command": "uvx",
              "args": ["mcp-server"]
            },
            "absolute": {
              "type": "stdio",
              "command": "/usr/bin/env",
              "cwd": "/opt/mcp"
            },
            "legacy": {
              "command": "npx",
              "environment": {
                "A": "1"
              },
              "enable": false,
              "timeout": 20,
              "startup_timeout_sec": 5
            },
            "quoted": {
              "command": "sh",
              "args": ["-c", "echo \"héllo\"\t\\ done"]
            }
          }
        }
      }
    }
  },
  {
    "name": "http and sse servers, oauth, headers and legacy remote names",
    "git": "repo",
    "workspace": "repo",
    "files": {
      "repo/zcode.json": {
        "mcp": {
          "servers": {
            "api": {
              "type": "http",
              "url": "https://mcp.example.com/v1?x=1",
              "headers": {
                "Authorization": "Bearer t"
              },
              "oauth": {
                "type": "client_credentials",
                "clientId": "c",
                "clientSecret": "s"
              }
            },
            "events": {
              "type": "sse",
              "url": "https://mcp.example.com/sse",
              "protocolVersion": "2026-07-28"
            },
            "old": {
              "type": "remote",
              "url": "https://mcp.example.com/old",
              "http_headers": {
                "X-Key": "k"
              }
            },
            "inferred": {
              "url": "https://mcp.example.com/inferred",
              "enabled": true,
              "timeoutMs": 30000
            },
            "off": {
              "type": "http",
              "url": "https://mcp.example.com/off",
              "enabled": false
            }
          }
        }
      }
    }
  },
  {
    "name": "an ancestor zcode.json declares, the user level shadows one, a nearer file has no servers",
    "git": "repo",
    "workspace": "repo/app",
    "user": {
      "mcp": {
        "servers": {
          "shadowed": {
            "command": "user-owned"
          }
        }
      }
    },
    "files": {
      "repo/zcode.json": {
        "mcp": {
          "servers": {
            "outer": {
              "command": "outer",
              "cwd": "bin"
            },
            "shadowed": {
              "command": "project-owned"
            },
            "top": {
              "command": "top"
            }
          }
        }
      },
      "repo/app/zcode.json": {
        "permission": {
          "allowedTools": ["Read"]
        }
      }
    }
  },
  {
    "name": "a .zcode/config.json in an ancestor resolves cwd from the directory above .zcode",
    "git": "repo",
    "workspace": "repo/app",
    "files": {
      "repo/.zcode/config.json": {
        "mcp": {
          "servers": {
            "dot": {
              "command": "dot",
              "cwd": "."
            },
            "up": {
              "command": "up",
              "cwd": "../x"
            }
          }
        }
      }
    }
  },
  {
    "name": "the nearer layer replaces a server with the same name",
    "git": "repo",
    "workspace": "repo/app",
    "files": {
      "repo/zcode.json": {
        "mcp": {
          "servers": {
            "both": {
              "command": "from-outer"
            }
          }
        }
      },
      "repo/app/.zcode/config.json": {
        "mcp": {
          "servers": {
            "both": {
              "command": "from-inner",
              "cwd": "tools"
            }
          }
        }
      }
    }
  },
  {
    "name": "windows unwraps cmd /c",
    "platform": "win32",
    "git": "repo",
    "workspace": "repo",
    "files": {
      "repo/.zcode/config.json": {
        "mcp": {
          "servers": {
            "wrapped": {
              "command": "cmd",
              "args": ["/c", "npx", "-y", "pkg"]
            },
            "wrappedExe": {
              "command": "CMD.EXE",
              "args": ["/c", "npx"]
            },
            "notWrapped": {
              "command": "cmd",
              "args": ["/k", "x"]
            },
            "nothingInside": {
              "command": "cmd",
              "args": ["/c"]
            }
          }
        }
      }
    }
  },
